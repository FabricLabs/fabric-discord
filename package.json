{
  "name": "@fabric/discord",
  "version": "0.1.0-dev",
  "description": "Discord connectivity for Fabric agents.",
  "main": "services/discord.js",
  "exports": {
    ".": "./services/discord.js",
    "./services/discord": "./services/discord.js",
    "./functions/normalizeDiscordSettings": "./functions/normalizeDiscordSettings.js",
    "./functions/voiceChannelStats": "./functions/voiceChannelStats.js",
    "./functions/discordCatalog": "./functions/discordCatalog.js",
    "./functions/discordStateAccumulate": "./functions/discordStateAccumulate.js",
    "./functions/channelMatcher": "./functions/channelMatcher.js",
    "./functions/metricBuckets": "./functions/metricBuckets.js",
    "./functions/messageText": "./functions/messageText.js",
    "./functions/nowPlaying": "./functions/nowPlaying.js",
    "./functions/voiceReceive": "./functions/voiceReceive.js",
    "./types/metricsPipeline": "./types/metricsPipeline.js",
    "./plugins": "./plugins/index.js",
    "./plugins/voiceActivity": "./plugins/voiceActivity.js",
    "./plugins/messageActivity": "./plugins/messageActivity.js"
  },
  "scripts": {
    "coverage": "NODE_ENV=test c8 npm test",
    "make:coverage": "npm run coverage && c8 report --reporter html",
    "report:coverage": "npm run make:coverage && mkdir -p reports && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "test": "NODE_ENV=test mocha tests --extension js --exit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/fabric-discord.git"
  },
  "keywords": [
    "fabric",
    "bitcoin",
    "discord"
  ],
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/fabric-discord/issues"
  },
  "homepage": "https://github.com/FabricLabs/fabric-discord#readme",
  "engines": {
    "node": "26.13.0",
    "npm": ">=12.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "=0.19.2",
    "@fabric/core": "FabricLabs/fabric#feature/schemas",
    "cross-fetch": "=4.1.0",
    "discord.js": "=14.27.0",
    "libsodium-wrappers": "=0.7.15",
    "lodash.merge": "=4.6.2",
    "opusscript": "=0.1.1"
  },
  "devDependencies": {
    "c8": "=12.0.0",
    "mocha": "=12.0.3"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "=14.0.3",
    "minimatch@>=9.0.0 <11.0.1": "=11.0.3"
  }
}
